# Copie este arquivo para "keystore.properties" (na mesma pasta) e deixe o arquivo da chave
# "iptv-player-assinatura.jks" também aqui. Os dois ficam fora do controle de versão (.gitignore).
# Com eles, o APK sai assinado com a MESMA chave das versões já instaladas (atualiza sem desinstalar).
storeFile=iptv-player-assinatura.jks
storePassword=android
keyAlias=androiddebugkey
keyPassword=android
