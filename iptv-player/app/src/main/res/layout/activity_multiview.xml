<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="2dp">

        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <include android:id="@+id/slot0" layout="@layout/item_mv_slot" />
            <include android:id="@+id/slot1" layout="@layout/item_mv_slot" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <include android:id="@+id/slot2" layout="@layout/item_mv_slot" />
            <include android:id="@+id/slot3" layout="@layout/item_mv_slot" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mvBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_osd"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMode2"
            style="@style/GhostButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mv_two" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMode4"
            style="@style/GhostButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/mv_four" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMvClose"
            style="@style/GhostButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/mv_close"
            app:icon="@drawable/ic_arrow_back" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMvHelp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_osd"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:text="@string/mv_help"
        android:textColor="@android:color/white"
        android:textSize="13sp" />
</FrameLayout>
