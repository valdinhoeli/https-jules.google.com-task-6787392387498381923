<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/controlsScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#40000000" />

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/gradient_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/PlayerButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEpg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Controles centrais -->
    <LinearLayout
        android:id="@+id/centerControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnPrev"
            style="@style/PlayerButton"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:contentDescription="@string/prev_channel"
            android:src="@drawable/ic_skip_previous" />

        <ImageButton
            android:id="@id/exo_play_pause"
            style="@style/PlayerButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginHorizontal="32dp"
            android:padding="16dp" />

        <ImageButton
            android:id="@+id/btnNext"
            style="@style/PlayerButton"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:contentDescription="@string/next_channel"
            android:src="@drawable/ic_skip_next" />
    </LinearLayout>

    <!-- Barra inferior -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_bottom"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="56dp"
        android:paddingBottom="12dp">

        <include
            android:id="@+id/bannerCtl"
            layout="@layout/view_epg_banner" />

        <LinearLayout
            android:id="@+id/timeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                app:played_color="@color/primary"
                app:scrubber_color="@color/primary" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnQuality"
                style="@style/PlayerButton"
                android:contentDescription="@string/quality"
                android:src="@drawable/ic_hq" />

            <ImageButton
                android:id="@+id/btnAudio"
                style="@style/PlayerButton"
                android:contentDescription="@string/audio"
                android:src="@drawable/ic_audio" />

            <ImageButton
                android:id="@+id/btnSubtitle"
                style="@style/PlayerButton"
                android:contentDescription="@string/subtitles"
                android:src="@drawable/ic_subtitles" />

            <ImageButton
                android:id="@+id/btnAspect"
                style="@style/PlayerButton"
                android:contentDescription="@string/aspect"
                android:src="@drawable/ic_aspect" />

            <ImageButton
                android:id="@+id/btnMulti"
                style="@style/PlayerButton"
                android:contentDescription="@string/action_multiview"
                android:src="@drawable/ic_grid" />

            <ImageButton
                android:id="@+id/btnPip"
                style="@style/PlayerButton"
                android:contentDescription="@string/pip"
                android:src="@drawable/ic_pip" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
