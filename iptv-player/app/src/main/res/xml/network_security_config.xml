<?xml version="1.0" encoding="utf-8"?>
<!--
  Muitas listas IPTV usam HTTP puro: o tráfego em texto claro continua liberado.
  Só certificados do sistema são aceitos (certificados instalados pelo usuário não),
  o que impede interceptar o tráfego HTTPS do app com proxies de inspeção.

  Android 7.0 e anteriores não têm a raiz do Let's Encrypt (ISRG Root X1/X2), usada pela maioria
  dos servidores HTTPS gratuitos: sem ela, listas, guias e logos em HTTPS não carregavam nesses
  aparelhos. As duas raízes oficiais (letsencrypt.org/certificates) vão junto com o app.
  ISRG Root X1 SHA-256 96:BC:EC:06:26:49:76:F3:74:60:77:9A:CF:28:C5:A7:CF:E8:A3:C0:AA:E1:1A:8F:FC:EE:05:C0:BD:DF:08:C6
  ISRG Root X2 SHA-256 69:72:9B:8E:15:A8:6E:FC:17:7A:57:AF:B7:17:1D:FC:64:AD:D2:8C:2F:CA:8C:F1:50:7E:34:45:3C:CB:14:70
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </base-config>
</network-security-config>
